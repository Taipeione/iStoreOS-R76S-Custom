# Stable base: iStoreOS 24.10 / FriendlyElec NanoPi R76S / RK3576.
#
# IMPORTANT:
# - Preserve board-detected interface/device mapping. Never hard-code eth0/eth1.
# - Keep the verified DNS chain:
#     dnsmasq:53 -> AdGuard Home 127.0.0.1:3053 -> SmartDNS :6053
# - China domains keep IPv4 + IPv6; other domains return IPv4 only.
# - PassWall keeps its routing / NFT / shunt machinery but must not replace
#   the system dnsmasq upstream.
# - No personal proxy/airport node is embedded in this firmware.
# - R76S v2.2.4 is TF-first. This script does not touch eMMC.

# -----------------------------------------------------------------------------
# 1. System root password
# -----------------------------------------------------------------------------
if command -v passwd >/dev/null 2>&1; then
    : 'DISABLED: no historical root password assignment'
fi

# -----------------------------------------------------------------------------
# 2. LAN: 192.168.50.1/24
# -----------------------------------------------------------------------------
if uci -q get network.lan >/dev/null 2>&1; then
    uci -q set network.lan.proto='static'
    uci -q set network.lan.ipaddr='192.168.50.1'
    uci -q set network.lan.netmask='255.255.255.0'
    uci -q commit network
fi

# -----------------------------------------------------------------------------
# 3. DHCP on LAN
# -----------------------------------------------------------------------------
if uci -q get dhcp.lan >/dev/null 2>&1; then
    uci -q set dhcp.lan.interface='lan'
    uci -q set dhcp.lan.ignore='0'
    uci -q set dhcp.lan.start='100'
    uci -q set dhcp.lan.limit='150'
    uci -q set dhcp.lan.leasetime='12h'
    uci -q commit dhcp
fi

# -----------------------------------------------------------------------------
# 4. Argon as the default LuCI theme
# -----------------------------------------------------------------------------
if [ -d /www/luci-static/argon ] && uci -q get luci.main >/dev/null 2>&1; then
    uci -q set luci.main.mediaurlbase='/luci-static/argon'
