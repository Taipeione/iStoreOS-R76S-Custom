        uci -q set passwall.@global_forwarding[0].udp_no_redir_ports='disable'
        uci -q set passwall.@global_forwarding[0].tcp_proxy_drop_ports='disable'
        uci -q set passwall.@global_forwarding[0].udp_proxy_drop_ports='443'
        uci -q set passwall.@global_forwarding[0].tcp_redir_ports='22,25,53,80,143,443,465,587,853,873,993,995,5222,8080,8443,9418'
        uci -q set passwall.@global_forwarding[0].udp_redir_ports='1:65535'
        uci -q set passwall.@global_forwarding[0].accept_icmp='0'
        uci -q set passwall.@global_forwarding[0].prefer_nft='1'
        uci -q set passwall.@global_forwarding[0].tcp_proxy_way='redirect'
        uci -q set passwall.@global_forwarding[0].ipv6_tproxy='0'
    fi

    uci -q commit passwall
    # Do not enable/start PassWall here. The DNS finalizer starts it only after
    # AdGuard Home and SmartDNS are confirmed healthy.
fi

# -----------------------------------------------------------------------------
# 7. PassWall DNS guard
#    PassWall's own App Update can replace /usr/share/passwall/app.sh.
#    This guard re-applies ONLY the verified external-DNS patch when needed.
# -----------------------------------------------------------------------------
mkdir -p /usr/libexec

cat > /usr/libexec/r76s-passwall-dns-guard <<'PWGUARD'
#!/bin/sh

APP='/usr/share/passwall/app.sh'
MARK_BEGIN='# R76S_EXTERNAL_DNS_BEGIN'
MARK_END='# R76S_EXTERNAL_DNS_END'
ANCHOR='uci -q delete dhcp.@dnsmasq[0].min_cache_ttl'
CHANGED=0

patch_app() {
    [ -f "$APP" ] || return 0
    grep -Fq "$MARK_BEGIN" "$APP" && return 0

    grep -Fq "$ANCHOR" "$APP" || {
        logger -t r76s-passwall-dns-guard 'PassWall app.sh anchor not found; DNS patch not applied.'
        return 1
    }

    SNIP="/tmp/r76s-passwall-dns-snippet.$$"
    NEW="/tmp/r76s-passwall-app.$$"

    cat > "$SNIP" <<'PATCH'
# R76S_EXTERNAL_DNS_BEGIN
# Keep PassWall routing / Xray / NFT / domain rules,
# but prevent PassWall from replacing the system dnsmasq upstream.
if [ -f "${GLOBAL_DNSMASQ_CONF}" ]; then
sed -i \
-e '/^server=127\.0\.0\.1#[0-9][0-9]*$/d' \
-e '/^server=::1#[0-9][0-9]*$/d' \
-e '/^all-servers$/d' \
-e '/^no-poll$/d' \
-e '/^no-resolv$/d' \
"${GLOBAL_DNSMASQ_CONF}"
fi
uci -q set dhcp.@dnsmasq[0].noresolv='1'
# R76S_EXTERNAL_DNS_END
PATCH

    awk -v anchor="$ANCHOR" -v snip="$SNIP" '
        BEGIN { inserted = 0 }
        index($0, anchor) && !inserted {
            while ((getline line < snip) > 0) print line
            close(snip)
            inserted = 1
        }
        { print }
        END {
            if (!inserted) exit 42
        }
    ' "$APP" > "$NEW" || {
        rm -f "$SNIP" "$NEW"
        return 1
    }

    sh -n "$NEW" || {
        logger -t r76s-passwall-dns-guard 'Patched app.sh failed syntax validation.'
        rm -f "$SNIP" "$NEW"
        return 1
    }

    cp -f "$APP" "${APP}.pre-r76s-update" >/dev/null 2>&1 || true
    chmod --reference="$APP" "$NEW" 2>/dev/null || chmod 0755 "$NEW"
    mv -f "$NEW" "$APP"
    rm -f "$SNIP"
    CHANGED=1
    logger -t r76s-passwall-dns-guard 'Re-applied R76S external-DNS patch to PassWall.'
}

patch_app || exit 1

# Before the proven DNS chain is finalized, patch app.sh only. Do not force
# no-resolv or restart PassWall yet, otherwise first boot could lose DNS before
# AdGuard Home is listening on 3053.
[ -e /etc/r76s-v2c-dns-ready ] || exit 0

DNSCFG_CHANGED=0
if [ "$(uci -q get dhcp.@dnsmasq[0].noresolv)" != "1" ]; then
    uci -q set dhcp.@dnsmasq[0].noresolv='1'
    DNSCFG_CHANGED=1
fi
if [ "$(uci -q get dhcp.@dnsmasq[0].extraconftext)" != "server=127.0.0.1#3053" ]; then
    uci -q set dhcp.@dnsmasq[0].extraconftext='server=127.0.0.1#3053'
    DNSCFG_CHANGED=1
fi
if [ "$(uci -q get dhcp.@dnsmasq[0].filter_aaaa)" != "0" ]; then
    uci -q set dhcp.@dnsmasq[0].filter_aaaa='0'
    DNSCFG_CHANGED=1
fi

if [ "$DNSCFG_CHANGED" -eq 1 ]; then
    uci -q commit dhcp
fi

if [ "$CHANGED" -eq 1 ]; then
    /etc/init.d/passwall restart >/dev/null 2>&1 || true
    sleep 2
    /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
elif [ "$DNSCFG_CHANGED" -eq 1 ]; then
    /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
fi

exit 0
PWGUARD

chmod 0755 /usr/libexec/r76s-passwall-dns-guard

# Patch app.sh before the first PassWall start. The guard intentionally does
# not restart PassWall until the DNS finalizer marks the main chain ready.
/usr/libexec/r76s-passwall-dns-guard >/dev/null 2>&1 || true

# Re-check after a future online PassWall App Update. Avoid duplicate cron rows.
mkdir -p /etc/crontabs
grep -Fq '/usr/libexec/r76s-passwall-dns-guard' /etc/crontabs/root 2>/dev/null ||     echo '*/2 * * * * /usr/libexec/r76s-passwall-dns-guard >/dev/null 2>&1' >> /etc/crontabs/root
/etc/init.d/cron enable >/dev/null 2>&1 || true
/etc/init.d/cron restart >/dev/null 2>&1 || true

# -----------------------------------------------------------------------------
# 8. Component updater
# -----------------------------------------------------------------------------
# The online component updater is packaged separately.
# available in LuCI, but remains OFF by default. The optional R76S recovery
# helper is deliberately not enabled during first boot.
fi

fi

fi

# -----------------------------------------------------------------------------
# 9. Retryable DNS finalizer.
#    Preserve the proven v2.0C install flow for AdGuard Home.
# -----------------------------------------------------------------------------
cat > /usr/libexec/r76s-v2c-dns-finalize <<'FINALIZER'
#!/bin/sh

MARKER='/etc/r76s-v2c-dns-ready'
AGH_CFG='/etc/adguardhome.yaml'
AGH_WORK='/var/lib/adguardhome'
LAN_IP='192.168.50.1'

[ -e "$MARKER" ] && exit 0

i=0
while [ "$i" -lt 90 ]; do
    if ip -4 addr show 2>/dev/null | grep -q '192\.168\.50\.1/24'; then
        break
    fi
    sleep 2
    i=$((i + 1))
done

if ! ip -4 addr show 2>/dev/null | grep -q '192\.168\.50\.1/24'; then
    logger -t r76s-v2c 'DNS finalizer: LAN 192.168.50.1 did not become ready.'
    exit 1
fi

if [ -x /etc/init.d/smartdns ]; then
    /etc/init.d/smartdns enable >/dev/null 2>&1 || true
    /etc/init.d/smartdns restart >/dev/null 2>&1 || true
fi

i=0
while [ "$i" -lt 30 ]; do
    if netstat -ln 2>/dev/null | grep -q ':6053'; then
        break
    fi
    sleep 2
    i=$((i + 1))
done

if ! netstat -ln 2>/dev/null | grep -q ':6053'; then
    logger -t r76s-v2c 'DNS finalizer: SmartDNS did not listen on 6053.'
    exit 1
fi

if [ -x /etc/init.d/adguardhome ]; then
    /etc/init.d/adguardhome enable >/dev/null 2>&1 || true
    /etc/init.d/adguardhome restart >/dev/null 2>&1 || true
fi

if [ ! -s "$AGH_CFG" ]; then
    i=0
    while [ "$i" -lt 45 ]; do
        if curl -fsS --max-time 2             "http://${LAN_IP}:3000/control/install/get_addresses"             >/dev/null 2>&1; then
            break
        fi
        sleep 2
        i=$((i + 1))
    done

    if ! curl -fsS --max-time 2         "http://${LAN_IP}:3000/control/install/get_addresses"         >/dev/null 2>&1; then
        logger -t r76s-v2c 'DNS finalizer: AdGuard Home install API was not reachable.'
        exit 1
    fi

    if ! false; then # DISABLED: historical AdGuard bootstrap with fixed credentials
        logger -t r76s-v2c 'DNS finalizer: AdGuard Home install/configure failed.'
        exit 1
    fi
fi

i=0
while [ "$i" -lt 30 ]; do
    [ -s "$AGH_CFG" ] && break
    sleep 2
    i=$((i + 1))
done

if [ ! -s "$AGH_CFG" ]; then
    logger -t r76s-v2c 'DNS finalizer: AdGuard Home configuration file was not created.'
    exit 1
fi

/etc/init.d/adguardhome stop >/dev/null 2>&1 || true
sleep 1

cp -f "$AGH_CFG" "${AGH_CFG}.v2c-base" || exit 1

sed -i 's#^  address: 192\.168\.50\.1:3001$#  address: 192.168.50.1:3000#' "$AGH_CFG" || exit 1

awk '
BEGIN { in_upstream = 0 }
/^  upstream_dns:/ {
    print "  upstream_dns:"
    print "    - 127.0.0.1:6053"
    in_upstream = 1
    next
}
in_upstream && /^  [A-Za-z0-9_]+:/ {
    in_upstream = 0
}
in_upstream { next }
{ print }
' "$AGH_CFG" > "${AGH_CFG}.v2c-new" || exit 1

mv -f "${AGH_CFG}.v2c-new" "$AGH_CFG" || exit 1
chmod 600 "$AGH_CFG" >/dev/null 2>&1 || true

grep -q '^  address: 192\.168\.50\.1:3000$' "$AGH_CFG" || {
    cp -f "${AGH_CFG}.v2c-base" "$AGH_CFG"
    /etc/init.d/adguardhome restart >/dev/null 2>&1 || true
    logger -t r76s-v2c 'DNS finalizer: unexpected AdGuard Home web binding.'
    exit 1
}

grep -A2 '^  bind_hosts:$' "$AGH_CFG" | grep -q '127\.0\.0\.1' || {
    cp -f "${AGH_CFG}.v2c-base" "$AGH_CFG"
    /etc/init.d/adguardhome restart >/dev/null 2>&1 || true
    logger -t r76s-v2c 'DNS finalizer: unexpected AdGuard Home DNS binding.'
    exit 1
}

grep -q '^  port: 3053$' "$AGH_CFG" || {
    cp -f "${AGH_CFG}.v2c-base" "$AGH_CFG"
    /etc/init.d/adguardhome restart >/dev/null 2>&1 || true
    logger -t r76s-v2c 'DNS finalizer: AdGuard Home DNS port is not 3053.'
    exit 1
}

grep -A2 '^  upstream_dns:$' "$AGH_CFG" | grep -q '127\.0\.0\.1:6053' || {
    cp -f "${AGH_CFG}.v2c-base" "$AGH_CFG"
    /etc/init.d/adguardhome restart >/dev/null 2>&1 || true
    logger -t r76s-v2c 'DNS finalizer: AdGuard Home upstream patch failed.'
    exit 1
}

if ! /usr/bin/AdGuardHome     --check-config     -c "$AGH_CFG"     -w "$AGH_WORK"     >/tmp/r76s-v2c-adguard-check.log 2>&1; then
    cp -f "${AGH_CFG}.v2c-base" "$AGH_CFG"
    /etc/init.d/adguardhome restart >/dev/null 2>&1 || true
    logger -t r76s-v2c 'DNS finalizer: AdGuard Home config validation failed.'
    exit 1
fi

/etc/init.d/adguardhome restart >/dev/null 2>&1 || exit 1

i=0
while [ "$i" -lt 30 ]; do
    if netstat -ln 2>/dev/null | grep -q '127\.0\.0\.1:3053'; then
        break
    fi
    sleep 2
    i=$((i + 1))
done

if ! netstat -ln 2>/dev/null | grep -q '127\.0\.0\.1:3053'; then
    logger -t r76s-v2c 'DNS finalizer: AdGuard Home did not listen on 127.0.0.1:3053.'
    exit 1
fi

uci -q delete dhcp.@dnsmasq[0].server || true
uci -q set dhcp.@dnsmasq[0].filter_aaaa='0'
uci -q set dhcp.@dnsmasq[0].filter_a='0'
uci -q set dhcp.@dnsmasq[0].extraconftext='server=127.0.0.1#3053'
uci -q set dhcp.@dnsmasq[0].noresolv='1'
uci -q commit dhcp

/etc/init.d/dnsmasq restart >/dev/null 2>&1 || exit 1
sleep 2

if ! grep -Rqs '^server=127\.0\.0\.1#3053$'     /tmp/dnsmasq.*.d/extraconfig.conf 2>/dev/null; then
    logger -t r76s-v2c 'DNS finalizer: dnsmasq did not render AdGuard Home upstream.'
    exit 1
fi

if ! nslookup www.qq.com "$LAN_IP" >/dev/null 2>&1; then
    logger -t r76s-v2c 'DNS finalizer: dnsmasq end-to-end DNS query failed.'
    exit 1
fi

# Now that the main DNS chain is live, start the verified PassWall framework.
# app.sh was patched earlier, so PassWall may add routing/domain-rule includes
# but must not replace the 3053 upstream.
if [ -x /etc/init.d/passwall ]; then
    /etc/init.d/passwall enable >/dev/null 2>&1 || true
    /etc/init.d/passwall restart >/dev/null 2>&1 || true
    sleep 4
fi

# Verify PassWall did not reintroduce its internal DNS as the main upstream.
if grep -RqsE '^server=(127\.0\.0\.1|::1)#[0-9]+$|^all-servers$'     /tmp/dnsmasq.*.d/dnsmasq-passwall.conf 2>/dev/null; then
    logger -t r76s-v2c 'DNS finalizer: PassWall attempted to replace the system DNS upstream.'
    exit 1
fi

if ! grep -Rqs '^server=127\.0\.0\.1#3053$'     /tmp/dnsmasq.*.d/extraconfig.conf 2>/dev/null; then
    logger -t r76s-v2c 'DNS finalizer: 3053 upstream disappeared after PassWall start.'
    exit 1
fi

if ! nslookup www.qq.com "$LAN_IP" >/dev/null 2>&1; then
    logger -t r76s-v2c 'DNS finalizer: DNS failed after PassWall start.'
    exit 1
fi

touch "$MARKER"
/etc/init.d/r76s-v2c-finalize disable >/dev/null 2>&1 || true
logger -t r76s-v2c 'DNS + PassWall ready: dnsmasq:53 -> AdGuardHome:3053 -> SmartDNS:6053.'

exit 0
FINALIZER

chmod 0755 /usr/libexec/r76s-v2c-dns-finalize

cat > /etc/init.d/r76s-v2c-finalize <<'INITSCRIPT'
#!/bin/sh /etc/rc.common

START=99
STOP=10

start() {
    [ -e /etc/r76s-v2c-dns-ready ] && return 0
    /usr/libexec/r76s-v2c-dns-finalize >>/tmp/r76s-v2c-finalize.log 2>&1 &
}

stop() {
    return 0
}
INITSCRIPT

chmod 0755 /etc/init.d/r76s-v2c-finalize
/etc/init.d/r76s-v2c-finalize enable >/dev/null 2>&1 || true
/etc/init.d/r76s-v2c-finalize start >/dev/null 2>&1 || true

exit 0

R76S_V12_LEGACY_RULE_DATA
