#!/bin/sh
# R76S_V142_FIXED_CLEAN_FLASH_PASSWORD
set -eu

FLAG="/etc/config/r76s_first_password_done"

# Already initialized
[ -f "$FLAG" ] && exit 0

# A preserved upgrade already has a user-selected root credential. Never
# replace it; clean images arrive with the locked root field from Stage 16.
ROOT_FIELD="$(sed -n 's/^root:\([^:]*\):.*/\1/p' /etc/shadow)"
if [ "$ROOT_FIELD" != '!' ] && [ -n "$ROOT_FIELD" ]; then
    touch "$FLAG"
    exit 0
fi

# Clean flash default: password
passwd root <<PASSWD
password
password
PASSWD

chmod 0600 /etc/shadow
touch "$FLAG"

exit 0
