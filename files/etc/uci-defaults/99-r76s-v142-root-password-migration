#!/bin/sh
# R76S_V142_ROOT_PASSWORD_MIGRATION
# V1.4.2 intentionally resets root once after a configuration-preserving
# upgrade.  The marker prevents later boots from overriding a password the
# administrator changes deliberately.
set -eu

MARKER="/etc/config/r76s_v142_root_password_migrated"
[ -f "$MARKER" ] && exit 0

REVISION=""
[ -r /etc/openwrt_release ] && REVISION="$(sed -n "s/^DISTRIB_REVISION=['\"]\([^'\"]*\)['\"].*/\1/p" /etc/openwrt_release)"
[ "$REVISION" = 'R76S-V1.4.2' ] || exit 0

passwd root <<'R76S_V142_PASSWORD'
password
password
R76S_V142_PASSWORD
chmod 0600 /etc/shadow
touch "$MARKER"
exit 0
