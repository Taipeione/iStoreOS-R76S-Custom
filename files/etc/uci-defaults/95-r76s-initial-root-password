#!/bin/sh
# R76S_V201_ROOT_PASSWORD_HASH
# Clean images receive the documented initial password through a SHA-512-crypt
# shadow entry.  A preserved /etc/shadow entry always wins during sysupgrade.
set -eu

MARKER=/etc/config/r76s_initial_root_password_applied
# shellcheck disable=SC2016
ROOT_HASH='$6$zWwwXKNj$gLAOoZCjcr8p/.VgV/FkGC3NX7BsXys3KHYePfuIGMNjY83dVxugPYlxVg/evpcVEJLT/rSwZcDMlVVf/bhf.1'

[ -e "$MARKER" ] && exit 0
[ -s /etc/shadow ] || exit 1

current="$(awk -F: '$1 == "root" { print $2; exit }' /etc/shadow)"
case "$current" in
    ''|'!'|'!!'|'*')
        tmp="$(mktemp /tmp/r76s-shadow.XXXXXX)"
        trap 'rm -f "$tmp"' EXIT
        awk -F: -v OFS=: -v hash="$ROOT_HASH" '$1 == "root" { $2 = hash } { print }' \
            /etc/shadow > "$tmp"
        chmod 0600 "$tmp"
        chown root:root "$tmp" 2>/dev/null || true
        mv "$tmp" /etc/shadow
        ;;
    *)
        # Preserve an administrator-selected password across upgrades.
        ;;
esac

mkdir -p /etc/config
touch "$MARKER"
chmod 0600 /etc/shadow
exit 0
