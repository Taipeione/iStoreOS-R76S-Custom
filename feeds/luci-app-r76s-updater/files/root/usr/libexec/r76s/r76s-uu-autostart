#!/bin/sh

log() { logger -t r76s-uu-autostart "$*"; }

[ "$(uci -q get uuplugin.@uuplugin[0].enabled)" = '1' ] || exit 0

log 'Waiting for WAN and DNS before validating UU...'
sleep 30

ready=0
i=0
while [ "$i" -lt 24 ]; do
    if ip -4 route 2>/dev/null | grep -q '^default ' && \
       nslookup router.uu.163.com 127.0.0.1 >/dev/null 2>&1; then
        ready=1
        break
    fi
    sleep 5
    i=$((i + 1))
done

[ "$ready" -eq 1 ] || {
    log 'WAN/DNS did not become ready; UU recovery skipped.'
    exit 1
}

if pidof uuplugin >/dev/null 2>&1; then
    log 'UU is already running.'
    exit 0
fi

log 'WAN/DNS ready but UU is not running; restarting UU.'
i=0
while [ "$i" -lt 24 ]; do
    /etc/init.d/uuplugin restart >/dev/null 2>&1 || true
    sleep 5
    if pidof uuplugin >/dev/null 2>&1 && [ -x /var/tmp/uu/uuplugin ]; then
        log 'UU recovery succeeded.'
        exit 0
    fi
    i=$((i + 1))
done

log 'UU recovery failed after 24 retries.'
exit 1
