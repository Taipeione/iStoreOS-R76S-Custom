#!/usr/bin/lua
-- Re-resolve explicit endpoint hosts; no keys, interfaces or routes are created here.
local sys=require 'luci.sys'
local uci=require('uci').cursor()
local function safe(s) return type(s)=='string' and s:match('^[%w%.:%-]+$') end
local function q(s) return "'"..s.."'" end
local ipv6=uci:get('r76s','main','endpoint_ipv6')=='1'
uci:foreach('network','interface',function(interface)
    if interface.proto~='wireguard' then return end
    local name=interface['.name']
    if not safe(name) then return end
    local now=os.time()
    local handshakes={}
    for key,stamp in sys.exec('wg show '..q(name)..' latest-handshakes 2>/dev/null'):gmatch('(%S+)%s+(%d+)') do
        handshakes[key]=tonumber(stamp)
    end
    uci:foreach('network','wireguard_'..name,function(peer)
        if peer.disabled=='1' or not safe(peer.endpoint_host) then return end
        local port=tonumber(peer.endpoint_port) or 51820
        local key=peer.public_key or ''
        if port<1 or port>65535 or not key:match('^[%w+/]+=*$') or #key~=44 then return end
        if handshakes[key] and now-handshakes[key]<180 then return end
        local v6=sys.exec('resolveip -6 -t 3 '..q(peer.endpoint_host)..' 2>/dev/null'):match('([%x:]+)')
        local v4=sys.exec('resolveip -4 -t 3 '..q(peer.endpoint_host)..' 2>/dev/null'):match('(%d+%.%d+%.%d+%.%d+)')
        -- Alternate after a stale handshake, allowing IPv4 fallback instead of pinning broken IPv6.
        local current=sys.exec('wg show '..q(name)..' endpoints 2>/dev/null')
        local addr=(ipv6 and v6 and not current:find('['..v6..']',1,true)) and ('['..v6..']') or v4
        if addr then
            if addr:sub(1,1)=='[' and uci:get('r76s_ip_policy','main','ipv6_guard')=='1' then
                -- Guard exception is only the encrypted router-originated UDP endpoint.
                local element=v6..' . '..port..' timeout 5m'
                if sys.call("nft add element inet r76s_ip6_guard wg6 '{ "..element.." }' >/dev/null 2>&1")~=0 then return end
            end
            sys.call('wg set '..q(name)..' peer '..q(key)..' endpoint '..q(addr..':'..port)..' >/dev/null 2>&1')
        end
    end)
end)
