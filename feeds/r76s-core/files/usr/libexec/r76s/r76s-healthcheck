#!/bin/sh
# Local readiness checks; no private node data is printed.
set -eu
/usr/libexec/r76s/r76s-service-manager reconcile
for service in passwall passwall2; do
    if [ "$(uci -q get "$service.@global[0].enabled")" = 1 ]; then
        pgrep -f "/tmp/etc/$service/" >/dev/null || {
            echo "$service: no runtime instance" >&2; exit 1;
        }
        nft list ruleset | grep -q "$service" || {
            echo "$service: no firewall rules" >&2; exit 1;
        }
    fi
done
if [ "$(uci -q get smartdns.@smartdns[0].enabled)" = 1 ]; then
    pgrep -f '[s]martdns' >/dev/null || exit 1
fi
dig @127.0.0.1 example.com A +time=2 +tries=1 +noall +comments | grep -q 'status: NOERROR'
